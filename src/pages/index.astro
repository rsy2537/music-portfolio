---
import BaseLayout from '../layouts/BaseLayout.astro';
import tracks from '../data/tracks.json';
---

<BaseLayout
title="Music Portfolio | 독립영화를 위한 맞춤 스코어"
description="독립영화 감독을 위한 맞춤 영화음악. 대표곡을 듣고, 마음에 드는 곡을 레퍼런스로 바로 의뢰할 수 있어요.">

  <h1>Music Portfolio</h1>
  <p class="sub">독립영화를 위한 맞춤 스코어</p>

  <ul class="track-list">
    {tracks.map((track) => (
      <li class="track">
        <div>
        <h2><a href={`/tracks/${track.slug}`}>{track.title}</a></h2>
          {track.emotion && <p class="sub tags">{track.emotion.join(' · ')}</p>}
        </div>
        <button
          type="button"
          class="play"
          data-src={`/audio/${track.slug}.mp3`}
          aria-label={`${track.title} 재생`}
        >
          ▶ 재생
        </button>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .track-list {
    list-style: none;
    padding: 0;
    margin-top: 48px;
  }
  .track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid #2A2420;
  }
  .track h2 {
    margin: 0 0 6px;
    font-size: 1.2rem;
    font-weight: 500;
  }
  .tags {
    margin: 0;
    font-size: 0.9rem;
  }
</style>