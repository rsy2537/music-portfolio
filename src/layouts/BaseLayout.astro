---
import '@fontsource/noto-sans-kr/400.css'; // 보통 굵기 (본문용)
import '@fontsource/noto-sans-kr/700.css'; // 굵게 (제목용)
import '@fontsource/noto-sans-kr/500.css'; // 중간 굵기 (곡 제목용)

// 모든 페이지가 같이 쓰는 틀(액자)
interface Props {
  title?: string;
  description?: string; // 페이지 설명
}
const {
  title = 'Music Portfolio',
  description = '독립영화를 위한 맞춤 스코어. 곡을 듣고 그 느낌 그대로 작업을 의뢰하세요.',
} = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <main>
      <!-- 각 페이지의 내용이 여기 들어온다 -->
      <slot />
    </main>

    <!-- 사이트 전체에서 하나만 쓰는 오디오 플레이어 -->
    <audio id="player" preload="none"></audio>
  </body>
</html>

<script>
  // 재생 기능은 src/scripts/player.ts 한 곳에서 관리한다
  import { bindPlayButtons } from '../scripts/player';
  bindPlayButtons();
</script>

<style is:global>
  body {
    margin: 0;
    background: #0B0908;
    color: #F0E6D2;
    font-family: 'Noto Sans KR', sans-serif;
  }
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 64px 24px;
  }
  a {
    color: inherit;
  }
  .sub {
    color: #A89C88;
  }
  .play {
    min-height: 44px;
    padding: 0 18px;
    background: transparent;
    color: #E8B04A;
    border: 1px solid #E8B04A;
    border-radius: 999px;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .play[aria-pressed="true"] {
    background: #E8B04A;
    color: #0B0908;
  }
</style>